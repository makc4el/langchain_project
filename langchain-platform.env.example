# LangChain Platform Deployment Environment Configuration
# Set these variables in your LangChain Platform project environment

# ==========================================
# REQUIRED: OpenAI Configuration
# ==========================================
OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# REQUIRED: MCP Server Configuration
# ==========================================
# URL of your Railway-deployed MCP Salesforce server
MCP_SALESFORCE_SERVER_URL=https://your-railway-app.railway.app

# ==========================================
# OPTIONAL: Search Integration
# ==========================================
# Tavily API key for internet search capabilities
# TAVILY_API_KEY=your_tavily_api_key_here

# ==========================================
# OPTIONAL: LangSmith Configuration
# ==========================================
# LangSmith for monitoring and tracing
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=salesforce-ai-agent
# LANGCHAIN_TRACING_V2=true

# ==========================================
# OPTIONAL: Application Configuration
# ==========================================
# Logging level
LOG_LEVEL=INFO

# ==========================================
# Notes for LangChain Platform
# ==========================================
# 1. The MCP_SALESFORCE_SERVER_URL should point to your Railway deployment
# 2. Make sure your Railway app has the CORS configuration to allow LangChain Platform domains
# 3. Users will provide Salesforce credentials (instanceUrl + accessToken/authCode) at runtime
# 4. No need to set Salesforce credentials here - they're provided dynamically by users
