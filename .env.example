# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to git - they contain sensitive data!

# =============================================================================
# REQUIRED - AI/LLM API KEYS
# =============================================================================

# OpenAI API Key (Required for ChatGPT functionality)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# OPTIONAL - EXTERNAL SERVICES
# =============================================================================

# Tavily API Key (Optional - for internet search functionality)
# Get from: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# =============================================================================
# LANGSMITH TRACING (OPTIONAL - FOR DEBUGGING)
# =============================================================================

# LangSmith Configuration for request tracing
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=salesforce-ai-agent

# =============================================================================
# MCP SALESFORCE SERVER CONFIGURATION
# =============================================================================

# MCP Salesforce Server URL (defaults to production if not set)
MCP_SALESFORCE_SERVER_URL=https://mcp-server-salesforce-production.up.railway.app

# =============================================================================
# SALESFORCE CREDENTIALS (FOR TESTING)
# =============================================================================
# Note: In production, users provide these through the chat interface
# These are only used for automated testing scripts

# Salesforce Instance URL
SALESFORCE_INSTANCE_URL=https://your-org.my.salesforce.com

# Salesforce Access Token (OAuth 2.0)
SALESFORCE_ACCESS_TOKEN=your_access_token_here

# Salesforce Refresh Token (OAuth 2.0)  
SALESFORCE_REFRESH_TOKEN=your_refresh_token_here

# Salesforce Authorization Code (OAuth 2.0)
SALESFORCE_AUTH_CODE=your_auth_code_here

# Salesforce Connected App Configuration (Optional - for MCP server OAuth)
SALESFORCE_CLIENT_ID=your_connected_app_consumer_key
SALESFORCE_CLIENT_SECRET=your_connected_app_consumer_secret
SALESFORCE_REDIRECT_URI=http://localhost:3000/callback

# =============================================================================
# LANGGRAPH PLATFORM DEPLOYMENT (FOR TESTING)
# =============================================================================

# LangGraph Platform Deployment URL (for testing deployed agents)
LANGGRAPH_DEPLOYMENT_URL=https://your-deployment-id.us.langgraph.app

# =============================================================================
# DATABASE CONFIGURATION (OPTIONAL - FOR ADVANCED FEATURES)
# =============================================================================

# PostgreSQL Database Configuration (Optional)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password

# Connection settings
POOL_TIMEOUT=60
CONNECTION_RETRIES=5
RETRY_DELAY=5

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Logging level
LOG_LEVEL=INFO

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 
# 1. NEVER commit .env files to version control
# 2. Keep your API keys secure and rotate them regularly  
# 3. Use different credentials for development, staging, and production
# 4. Consider using a secrets management service for production deployments
# 5. Salesforce credentials should be obtained fresh for each session
# 6. Access tokens typically expire after 2 hours
# 7. Refresh tokens can be used to obtain new access tokens
#
# For Salesforce OAuth setup:
# - Create a Connected App in Salesforce Setup
# - Enable OAuth Settings  
# - Configure appropriate OAuth scopes (api, refresh_token)
# - Set the redirect URI to match your application
# - Use the Consumer Key as CLIENT_ID and Consumer Secret as CLIENT_SECRET
#
